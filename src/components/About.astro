---
import { siteConfig } from "../config";

const backendSkills = siteConfig.skills.filter((s) =>
  ["Java", "Kotlin", "Spring Boot", "Laravel", "PostgreSQL", "GraphQL", "Kafka", "Mockito"].includes(s)
);

const frontendSkills = siteConfig.skills.filter((s) =>
  ["JavaScript", "TypeScript", "Angular", "React", "NextJS", "Tanstack Start", "Jest"].includes(s)
);

const toolsSkills = siteConfig.skills.filter((s) =>
  ["Docker", "AWS", "Git", "CI/CD"].includes(s)
);

const skillCategories = [
  { label: "Backend", skills: backendSkills, span: "md:col-span-2" },
  { label: "Frontend", skills: frontendSkills, span: "" },
  { label: "Tools & Infra", skills: toolsSkills, span: "" },
];

const hasLanguages = siteConfig.languages && siteConfig.languages.length > 0;
---

<section id="about" class="relative py-32 md:py-40 px-6 md:px-12 lg:px-16">

  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-16">
      <!-- Left column - Sticky header -->
      <div class="xl:col-span-4 xl:sticky xl:top-32 xl:self-start">
        <div class="space-y-4 scroll-reveal">
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
            About
          </h2>
          <div class="accent-line animate h-3"></div>
        </div>
      </div>

      <!-- Right column - Content -->
      <div class="xl:col-span-8 space-y-12">
        <!-- Bio -->
        <div class="scroll-reveal">
          <p class="text-base md:text-lg lg:text-xl leading-relaxed text-[var(--theme-text-secondary)] font-light">
            {siteConfig.aboutMe}
          </p>
        </div>

        <!-- Skills in Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4">
          {skillCategories.map((cat, i) => (
            <div class={`bezel scroll-reveal ${cat.span}`} data-delay={String(i + 1)}>
              <div class="bezel-inner p-5 md:p-6">
                <p class="eyebrow mb-4">{cat.label}</p>
                <div class="flex flex-wrap gap-2">
                  {cat.skills.map((skill) => (
                    <span class="skill-pill">{skill}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}

          <!-- Languages -->
          {hasLanguages && (
            <div class="bezel md:col-span-2 scroll-reveal" data-delay="4">
              <div class="bezel-inner p-5 md:p-6">
                <p class="eyebrow mb-4">Languages</p>
                <div class="flex flex-wrap gap-6">
                  {siteConfig.languages.map((lang) => (
                    <div class="flex items-center gap-3">
                      <span class="text-sm text-[var(--theme-text-primary)] font-medium">{lang.name}</span>
                      <div class="flex gap-1.5">
                        {[1, 2, 3, 4, 5].map((level) => (
                          <span
                            class="lang-dot"
                            style={`background: ${level <= lang.level ? 'var(--theme-accent)' : 'var(--theme-border)'}`}
                          />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transition: background-color 0.5s var(--ease-out-expo);
  }
</style>

---
import { siteConfig } from "../config";

const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="relative py-32 md:py-40 px-6 md:px-12 lg:px-16">

      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-16">
          <!-- Left column - Sticky header -->
          <div class="xl:col-span-4 xl:sticky xl:top-32 xl:self-start">
            <div class="space-y-4 scroll-reveal">
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
                Education
              </h2>
              <div class="accent-line animate h-3"></div>
            </div>
          </div>

          <!-- Right column - Education cards -->
          <div class="xl:col-span-8">
            <div class="space-y-6">
              {siteConfig.education.map((edu, index) => (
                <div class="scroll-reveal" data-delay={String(Math.min(index + 1, 3))}>
                  <div class="bezel">
                    <div class="bezel-inner p-6 md:p-8">
                      <div class="space-y-2">
                        <h3 class="text-xl md:text-2xl font-semibold text-[var(--theme-accent)]">
                          {edu.school}
                        </h3>
                        <p class="text-base md:text-lg text-[var(--theme-text-primary)]">
                          {edu.degree}
                        </p>
                        <p class="text-xs font-light uppercase tracking-widest text-[var(--theme-text-secondary)]">
                          {edu.dateRange}
                        </p>
                      </div>

                      {edu.achievements && edu.achievements.length > 0 && (
                        <ul class="mt-4 space-y-2">
                          {edu.achievements.map((achievement) => (
                            <li class="flex items-start gap-3 text-sm text-[var(--theme-text-secondary)] leading-relaxed">
                              <span class="text-[var(--theme-accent)] font-light mt-0.5 flex-shrink-0">&gt;</span>
                              <span>{achievement}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

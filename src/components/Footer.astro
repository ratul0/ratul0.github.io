---
import { siteConfig } from "../config";

const getCurrentYear = new Date().getFullYear();
const startYear = 2017;
const yearsOfExperience = getCurrentYear - startYear;

const status = {
  availability: "open to opportunities",
  experience: `${yearsOfExperience}+ years`,
  base: "Bremen, DE",
};

// Lighthouse data
let lhScores: Record<string, number> | null = null;
try {
  const data = await import("../data/lighthouse.json");
  if (data.scores) lhScores = data.scores;
} catch { /* gauges won't render */ }

const MINI_R = 16;

function getColor(score: number): string {
  if (score >= 90) return "#0cce6b";
  if (score >= 50) return "#ffa400";
  return "#ff4e42";
}

const hasLighthouse = lhScores && Object.values(lhScores).some((v: number) => v > 0);

const miniGauges = hasLighthouse
  ? [
      { key: "performance", label: "Perf" },
      { key: "accessibility", label: "A11y" },
      { key: "bestPractices", label: "Best P." },
      { key: "seo", label: "SEO" },
    ].map((cat, i) => {
      const score = lhScores![cat.key] ?? 0;
      const color = getColor(score);
      return { ...cat, score, color, index: i };
    })
  : [];
---

<footer class="relative py-24 md:py-32 px-6 md:px-12 lg:px-16 border-t border-[var(--theme-border)] overflow-hidden">
  <!-- Grid background -->
  <div class="footer-grid absolute inset-0 opacity-[0.02]"></div>

  <div class="max-w-6xl mx-auto relative space-y-12">

    <!-- Zone 1 — Status Panel + Lighthouse -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

      <!-- Left: Status Panel (col-span-7) -->
      <div class="lg:col-span-7 scroll-reveal" data-delay="1">
        <div class="bezel">
          <div class="bezel-inner">
            <div class="panel-header">
              <span class="panel-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </span>
              <span class="panel-title">status.json</span>
            </div>

            <div class="panel-content font-mono text-xs md:text-sm" id="status-panel">
              <span class="text-[var(--theme-text-secondary)]">{"{"}</span>
              {Object.entries(status).map(([key, value], index) => (
                <div class="status-line status-animate pl-2 md:pl-4" style={`--line-index: ${index}`}>
                  <span class="key">"{key}"</span>
                  <span class="colon">:</span>
                  <span class="value">"{value}"</span>
                  {index < Object.keys(status).length - 1
                    ? <span class="text-[var(--theme-text-secondary)]">,</span>
                    : null
                  }
                </div>
              ))}
              <span class="text-[var(--theme-text-secondary)]">{"}"}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Lighthouse Gauges (col-span-5) -->
      {hasLighthouse && (
        <div class="lg:col-span-5 scroll-reveal" data-delay="2">
          <div class="bezel h-full">
            <div class="bezel-inner h-full">
              <div class="lighthouse-compact" id="footer-gauges">
                <div class="mini-gauge-row">
                  {miniGauges.map((g) => (
                    <div
                      class="mini-gauge"
                      data-score={g.score}
                      data-color={g.color}
                      data-index={g.index}
                    >
                      <svg
                        class="mini-gauge-svg"
                        viewBox="0 0 40 40"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <circle
                          cx="20"
                          cy="20"
                          r={MINI_R}
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          class="mini-gauge-track"
                        />
                        <circle
                          cx="20"
                          cy="20"
                          r={MINI_R}
                          fill="none"
                          stroke={g.color}
                          stroke-width="3"
                          stroke-linecap="round"
                          class="mini-gauge-ring"
                          transform="rotate(-90 20 20)"
                        />
                      </svg>
                      <span class="mini-gauge-score">0</span>
                      <span class="mini-gauge-label">{g.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <a
            href="https://pagespeed.web.dev/analysis?url=https://ratul0.github.io&form_factor=desktop"
            target="_blank"
            rel="noopener noreferrer"
            class="verify-link"
          >
            Verify lighthouse scores ↗
          </a>
        </div>
      )}
    </div>

    <!-- Zone 2 — Contact Strip -->
    <div class="scroll-reveal" data-delay="3">
      <a
        href={`mailto:${siteConfig.social.email}`}
        class="contact-rule group"
      >
        <span class="contact-rule-line"></span>
        <span class="contact-rule-email">
          {siteConfig.social.email}
          <span class="arrow-badge w-6 h-6 ml-2 group-hover:translate-x-0.5 group-hover:-translate-y-px group-hover:scale-105">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M22 7l-10 7L2 7" />
            </svg>
          </span>
        </span>
        <span class="contact-rule-line"></span>
      </a>
    </div>

    <!-- Zone 3 — Footer Bar -->
    <div class="pt-8 border-t border-[var(--theme-border)]">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-xs font-mono text-[var(--theme-text-secondary)] opacity-50">
          &copy; {getCurrentYear} {siteConfig.name}.
        </p>
        <p class="text-xs font-mono text-[var(--theme-text-secondary)] opacity-50">
          Built with Astro + Tailwind
        </p>
      </div>
      <nav aria-label="Site information" class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs font-mono">
        <a class="text-[var(--theme-accent)]" href="/about/">About</a>
        <a class="text-[var(--theme-accent)]" href="/contact/">Contact</a>
        <a class="text-[var(--theme-accent)]" href="/privacy/">Privacy</a>
        <a class="text-[var(--theme-accent)]" href="/llms.txt">Agent guide</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    background-image:
      linear-gradient(var(--theme-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--theme-border) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
  }

  /* ═══════════════════════════════════════
     ZONE 2 — CONTACT RULE
     ═══════════════════════════════════════ */

  .contact-rule {
    display: flex;
    align-items: center;
    gap: 20px;
    text-decoration: none;
    padding: 8px 0;
  }

  .contact-rule-line {
    flex: 1;
    height: 1px;
    background: var(--theme-border);
    min-width: 24px;
    transition: background-color 0.5s var(--ease-out-expo);
  }

  .contact-rule:hover .contact-rule-line {
    background: var(--theme-accent);
  }

  .contact-rule-email {
    font-size: 1rem;
    font-weight: 500;
    color: var(--theme-accent);
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    transition: transform 0.5s var(--ease-out-expo);
  }

  @media (min-width: 768px) {
    .contact-rule-email {
      font-size: 1.125rem;
    }
  }

  .contact-rule:hover .contact-rule-email {
    transform: translateY(-1px);
  }

  /* ═══════════════════════════════════════
     STATUS PANEL
     ═══════════════════════════════════════ */

  .panel-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--theme-border);
    background: rgba(0, 0, 0, 0.02);
    transition: background-color 0.3s ease;
  }

  body.dark .panel-header {
    background: rgba(255, 255, 255, 0.02);
  }

  .panel-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f57; border: 1px solid #e0443e; }
  .dot.yellow { background: #febc2e; border: 1px solid #d89e24; }
  .dot.green { background: #28c840; border: 1px solid #1aab29; }

  .panel-title {
    font-size: 11px;
    color: var(--theme-text-secondary);
    font-weight: 500;
  }

  .panel-content {
    padding: 10px 12px;
  }

  .status-line {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-right: 8px;
    line-height: 1.6;
    border-radius: 4px;
    transition:
      background-color 0.3s ease,
      padding-left 0.3s ease;
  }

  .status-line:hover {
    background: rgba(15, 76, 92, 0.04);
  }

  body.dark .status-line:hover {
    background: rgba(92, 188, 208, 0.06);
  }

  .status-line:hover .key {
    color: var(--theme-accent);
    filter: brightness(1.15);
  }

  .key { color: var(--theme-accent); transition: filter 0.3s ease; }
  .colon { color: var(--theme-text-secondary); }
  .value { color: var(--theme-text-secondary); }

  /* ═══════════════════════════════════════
     STATUS LINE STAGGERED REVEAL
     ═══════════════════════════════════════ */

  .status-animate {
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo),
      background-color 0.3s ease,
      padding-left 0.3s ease;
    transition-delay: calc(var(--line-index, 0) * 120ms);
  }

  .status-animate.revealed {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .status-animate {
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
  }

  /* ═══════════════════════════════════════
     MINI LIGHTHOUSE GAUGES
     ═══════════════════════════════════════ */

  .lighthouse-compact {
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
  }

  .mini-gauge-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    width: 100%;
  }

  .mini-gauge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .mini-gauge-svg {
    width: 72px;
    height: 72px;
    display: block;
  }

  .mini-gauge-track {
    opacity: 0.15;
  }

  .mini-gauge-ring {
    stroke-dasharray: 100.53;
    stroke-dashoffset: 100.53;
    transition: none;
  }

  .mini-gauge-score {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    font-family: "IBM Plex Mono", monospace;
    color: var(--theme-text-primary);
  }

  .mini-gauge-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--theme-text-secondary);
    text-align: center;
  }

  .verify-link {
    display: block;
    text-align: right;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--theme-text-secondary);
    opacity: 0.4;
    text-decoration: none;
    margin-top: 8px;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .verify-link:hover {
    opacity: 1;
    color: var(--theme-accent);
  }

</style>

<script>
  // Status line staggered reveal
  function initStatusReveal() {
    const panel = document.getElementById("status-panel");
    if (!panel) return;

    const lines = panel.querySelectorAll<HTMLElement>(".status-animate");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      lines.forEach((line) => line.classList.add("revealed"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          lines.forEach((line) => line.classList.add("revealed"));
        }
      },
      { threshold: 0.3 }
    );

    observer.observe(panel);
  }

  initStatusReveal();
  document.addEventListener("astro:after-swap", initStatusReveal);

  // Mini lighthouse gauge animation
  let gaugeObserver: IntersectionObserver | null = null;

  function animateFooterGauges() {
    if (gaugeObserver) {
      gaugeObserver.disconnect();
      gaugeObserver = null;
    }

    const container = document.getElementById("footer-gauges");
    if (!container) return;

    const gauges = container.querySelectorAll<HTMLElement>(".mini-gauge");
    const circumference = 100.53;

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          gaugeObserver = null;

          gauges.forEach((gauge) => {
            const score = parseInt(gauge.dataset.score || "0", 10);
            const color = gauge.dataset.color || "#0cce6b";
            const index = parseInt(gauge.dataset.index || "0", 10);
            const delay = index * 100;

            const ring = gauge.querySelector<SVGCircleElement>(".mini-gauge-ring");
            const scoreEl = gauge.querySelector<HTMLElement>(".mini-gauge-score");
            if (!ring || !scoreEl) return;

            const finalOffset = circumference * (1 - score / 100);

            setTimeout(() => {
              ring.style.stroke = color;
              ring.style.transition = `stroke-dashoffset 0.9s cubic-bezier(0.32, 0.72, 0, 1)`;
              ring.style.strokeDashoffset = `${finalOffset}`;

              const duration = 900;
              const start = performance.now();

              function updateCount(now: number) {
                const elapsed = now - start;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(eased * score);
                scoreEl!.textContent = String(current);

                if (progress < 1) {
                  requestAnimationFrame(updateCount);
                }
              }

              requestAnimationFrame(updateCount);
            }, delay);
          });
        }
      },
      { threshold: 0.3 }
    );

    gaugeObserver = observer;
    observer.observe(container);
  }

  animateFooterGauges();
  document.addEventListener("astro:after-swap", animateFooterGauges);
</script>

---
import { siteConfig } from "../config";
import { Icon } from "astro-icon/components";

const getCurrentYear = new Date().getFullYear();
const startYear = 2017;
const yearsOfExperience = getCurrentYear - startYear;

const status = {
  availability: "Open to opportunities",
  experience: `${yearsOfExperience}+ years`,
  location: "Remote / Germany",
  response_time: "<24 hours",
};

// Social links for footer nav (filter to external links only)
const footerSocials = [
  siteConfig.social?.linkedin && { href: siteConfig.social.linkedin, label: "LinkedIn", icon: "simple-icons:linkedin" },
  siteConfig.social?.resume && { href: siteConfig.social.resume, label: "Resume", icon: "simple-icons:readdotcv" },
  siteConfig.social?.github && { href: siteConfig.social.github, label: "GitHub", icon: "simple-icons:github" },
].filter(Boolean) as { href: string; label: string; icon: string }[];
---

<footer class="relative py-24 md:py-32 px-6 md:px-12 lg:px-16 border-t border-[var(--theme-border)] overflow-hidden">
  <!-- Grid background -->
  <div class="footer-grid absolute inset-0 opacity-[0.02]"></div>

  <div class="max-w-6xl mx-auto relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left: CTA Section -->
      <div class="lg:col-span-7 space-y-8 scroll-reveal">
        <p class="text-xl md:text-2xl lg:text-3xl font-semibold text-[var(--theme-text-primary)] leading-tight whitespace-nowrap">
          From concept to deployment
        </p>

        <!-- Button-in-Button CTA -->
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="group inline-flex items-center gap-0 rounded-full border border-[var(--theme-border)] pl-6 pr-1.5 py-1.5 transition-colors duration-500 ease-expo hover:border-[var(--theme-accent)]"
        >
          <span class="text-sm md:text-base text-[var(--theme-accent)] font-medium pr-3">
            {siteConfig.social.email}
          </span>
          <span class="arrow-badge w-8 h-8 group-hover:translate-x-0.5 group-hover:-translate-y-px group-hover:scale-105">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 10L10 2M10 2H4M10 2V8" />
            </svg>
          </span>
        </a>
      </div>

      <!-- Right: Status Panel -->
      <div class="lg:col-span-5 scroll-reveal" data-delay="1">
        <!-- Double-Bezel status panel -->
        <div class="bezel mb-4">
          <div class="bezel-inner">
            <div class="panel-header">
              <span class="panel-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </span>
              <span class="panel-title">status.json</span>
            </div>

            <div class="panel-content font-mono text-xs md:text-sm">
              <span class="text-[var(--theme-text-secondary)]">{"{"}</span>
              {Object.entries(status).map(([key, value], index) => (
                <div class="status-line pl-2 md:pl-4">
                  <span class="key">"{key}"</span>
                  <span class="colon">:</span>
                  <span class="value">"{value}"</span>
                  {index < Object.keys(status).length - 1
                    ? <span class="text-[var(--theme-text-secondary)]">,</span>
                    : <span id="trailing-comma" class="text-[var(--theme-text-secondary)]" hidden>,</span>
                  }
                </div>
              ))}
              <div id="visits-line" class="status-line pl-2 md:pl-4" hidden>
                <span class="key">"site_visits"</span>
                <span class="colon">:</span>
                <span class="value" id="visits-value">"0"</span>
              </div>
              <span class="text-[var(--theme-text-secondary)]">{"}"}</span>
            </div>
          </div>
        </div>

        <!-- Social links -->
        <nav class="social-nav">
          {footerSocials.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="social-item group">
              <Icon name={link.icon} width="16" height="16" />
              <span>{link.label}</span>
              <span class="arrow arrow-badge w-5 h-5 group-hover:translate-x-0.5 group-hover:-translate-y-px">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 7L7 1M7 1H3M7 1V5" />
                </svg>
              </span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 border-t border-[var(--theme-border)]">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-xs font-mono text-[var(--theme-text-secondary)] opacity-50">
          &copy; {getCurrentYear} {siteConfig.name}.
        </p>
        <div class="flex items-center gap-2 text-xs font-mono text-[var(--theme-text-secondary)] opacity-40">
          <span class="status-indicator"></span>
          <span>Build v2.0.0 :: stable</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    background-image:
      linear-gradient(var(--theme-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--theme-border) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
  }

  /* Panel styling */
  .panel-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--theme-border);
    background: rgba(0, 0, 0, 0.02);
    transition: background-color 0.3s ease;
  }

  body.dark .panel-header {
    background: rgba(255, 255, 255, 0.02);
  }

  .panel-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f57; border: 1px solid #e0443e; }
  .dot.yellow { background: #febc2e; border: 1px solid #d89e24; }
  .dot.green { background: #28c840; border: 1px solid #1aab29; }

  .panel-title {
    font-size: 11px;
    color: var(--theme-text-secondary);
    font-weight: 500;
  }

  .panel-content {
    padding: 14px;
  }

  .status-line {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    line-height: 1.6;
  }

  .key { color: var(--theme-accent); }
  .colon { color: var(--theme-text-secondary); }
  .value { color: var(--theme-text-secondary); }

  /* Social nav */
  .social-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .social-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--theme-border);
    border-radius: 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--theme-text-secondary);
    text-decoration: none;
    transition:
      border-color 0.5s var(--ease-out-expo),
      color 0.5s var(--ease-out-expo),
      background-color 0.5s var(--ease-out-expo);
  }

  .social-item svg:first-child {
    flex-shrink: 0;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .social-item .arrow {
    margin-left: auto;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo),
      background-color 0.5s var(--ease-out-expo),
      color 0.5s var(--ease-out-expo);
  }

  .social-item:hover {
    border-color: var(--theme-accent);
    color: var(--theme-accent);
    background: rgba(15, 76, 92, 0.03);
  }

  body.dark .social-item:hover {
    background: rgba(92, 188, 208, 0.06);
  }

  .social-item:hover svg:first-child {
    transform: scale(1.1);
  }

  .social-item:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Status pulse */
  .status-indicator {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--theme-accent);
    animation: statusPulse 2s ease-in-out infinite;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.9); }
  }
</style>

<script>
  try {
    const res = await fetch("https://api.counterapi.dev/v1/ratul0-github-io/visitors/up");
    if (!res.ok) throw new Error();
    const count = Number((await res.json()).count);
    if (!Number.isFinite(count)) throw new Error();

    document.getElementById("visits-value")!.textContent = `"${count.toLocaleString()}"`;
    document.getElementById("visits-line")!.hidden = false;
    document.getElementById("trailing-comma")!.hidden = false;
  } catch {
    // API down → visits row stays hidden, panel unchanged
  }
</script>

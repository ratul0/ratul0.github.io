---
import { siteConfig } from "../config";

const githubUrl = siteConfig.social?.github;
const githubUsername = githubUrl ? githubUrl.split("/").pop() : "";
const accentHex = siteConfig.accentColor.replace("#", "");
---

{
  githubUrl && (
    <section id="github" class="relative py-32 md:py-40 px-6 md:px-12 lg:px-16">

      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <!-- Left column - Sticky header -->
          <div class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start">
            <div class="space-y-4 scroll-reveal">
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
                Activity
              </h2>
              <div class="accent-line animate h-3"></div>
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="section-link"
              >
                View profile ↗
              </a>
            </div>
          </div>

          <!-- Right column - Heatmap -->
          <div class="lg:col-span-8">
            <div class="scroll-reveal" data-delay="1">
              <div class="bezel">
                <div class="bezel-inner p-6 md:p-8">
                  <img
                    src={`https://ghchart.rshah.org/${accentHex}/${githubUsername}`}
                    alt={`${githubUsername}'s GitHub contribution chart`}
                    class="gh-chart w-full h-auto"
                    width="800"
                    height="130"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  body.dark .gh-chart {
    filter: invert(1) hue-rotate(180deg);
  }
</style>

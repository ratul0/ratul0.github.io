---
import { siteConfig } from "../config";
import { Icon } from "astro-icon/components";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const hasReferences = siteConfig.references && siteConfig.references.length > 0;
const hasGithub = !!siteConfig.social?.github;

// Social links defined once, rendered in both desktop pill and mobile overlay
const socialLinks = [
  siteConfig.social?.email && { href: `mailto:${siteConfig.social.email}`, label: "Email", icon: "simple-icons:gmail" },
  siteConfig.social?.linkedin && { href: siteConfig.social.linkedin, label: "LinkedIn", icon: "simple-icons:linkedin", external: true },
  siteConfig.social?.medium && { href: siteConfig.social.medium, label: "Medium", icon: "simple-icons:medium", external: true },
  siteConfig.social?.resume && { href: siteConfig.social.resume, label: "Resume", icon: "simple-icons:readdotcv", external: true },
  siteConfig.social?.github && { href: siteConfig.social.github, label: "GitHub", icon: "simple-icons:github", external: true },
].filter(Boolean) as { href: string; label: string; icon: string; external?: boolean }[];
---

<!-- Floating Glass Pill Navigation -->
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 pointer-events-none header-visible">
  <div class="flex justify-center pt-5 px-4">
    <nav id="glass-pill" class="glass-pill pointer-events-auto">
      <!-- Terminal prompt / logo -->
      <button id="scroll-top-btn" class="prompt-link" aria-label="Scroll to top">
        <span class="prompt-user">yousuf</span><span class="prompt-sep">@</span><span class="prompt-host">khan</span><span class="prompt-colon">:</span><span class="prompt-path">~</span>
      </button>

      <!-- Divider -->
      <div class="pill-divider desktop-only"></div>

      <!-- Desktop navigation links -->
      <div class="desktop-nav">
        <a href="#about" data-nav="about" class="pill-link">About</a>
        {hasProjects && <a href="#projects" data-nav="projects" class="pill-link">Projects</a>}
        {hasExperience && <a href="#experience" data-nav="experience" class="pill-link">Experience</a>}
        {hasEducation && <a href="#education" data-nav="education" class="pill-link">Education</a>}
        {hasReferences && <a href="#references" data-nav="references" class="pill-link">References</a>}
        {hasGithub && <a href="#github" data-nav="github" class="pill-link">Activity</a>}
      </div>

      <!-- Divider -->
      <div class="pill-divider desktop-only"></div>

      <!-- Social icons (desktop) -->
      <div class="pill-socials desktop-only">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            aria-label={link.label}
            class="pill-social-icon"
          >
            <Icon name={link.icon} width="13" height="13" />
          </a>
        ))}
      </div>

      <!-- Mobile hamburger -->
      <button
        id="hamburger-btn"
        class="hamburger"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-overlay"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </nav>
  </div>
</header>

<!--
  Must stay outside <header>: the header is transformed (show/hide on scroll),
  which would make it the containing block for this fixed overlay and shrink it
  to the header's own box instead of the viewport.
-->
<div id="mobile-overlay" class="mobile-overlay">
  <nav class="overlay-content" aria-label="Mobile">
    <a href="#about" class="overlay-link" style="--i: 0">About</a>
    {hasProjects && <a href="#projects" class="overlay-link" style="--i: 1">Projects</a>}
    {hasExperience && <a href="#experience" class="overlay-link" style="--i: 2">Experience</a>}
    {hasEducation && <a href="#education" class="overlay-link" style="--i: 3">Education</a>}
    {hasReferences && <a href="#references" class="overlay-link" style="--i: 4">References</a>}
    {hasGithub && <a href="#github" class="overlay-link" style="--i: 5">Activity</a>}

    <!-- Social icons in overlay -->
    <div class="overlay-socials" style="--i: 6">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          aria-label={link.label}
          class="overlay-social-icon"
        >
          <Icon name={link.icon} width="20" height="20" />
        </a>
      ))}
    </div>
  </nav>
</div>

<style>
  /* ═══ HEADER SHOW/HIDE ═══ */
  #site-header {
    transition: transform 0.4s var(--ease-out-expo);
    will-change: transform;
  }

  #site-header.header-hidden {
    transform: translateY(-100%);
  }

  #site-header.header-visible {
    transform: translateY(0);
  }

  /* ═══ GLASS PILL ═══ */
  .glass-pill {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 20px;
    border-radius: 9999px;
    background: rgba(250, 248, 245, 0.72);
    border: 1px solid rgba(232, 228, 223, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.03),
      0 1px 2px rgba(0, 0, 0, 0.02);
    transition:
      background 0.7s var(--ease-out-expo),
      box-shadow 0.7s var(--ease-out-expo),
      border-color 0.7s var(--ease-out-expo);
  }

  body.dark .glass-pill {
    background: rgba(6, 6, 9, 0.72);
    border-color: rgba(30, 36, 48, 0.8);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.2),
      0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .glass-pill.scrolled {
    background: rgba(250, 248, 245, 0.92);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
  }

  body.dark .glass-pill.scrolled {
    background: rgba(6, 6, 9, 0.92);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  /* ═══ PROMPT / LOGO ═══ */
  .prompt-link {
    display: flex;
    align-items: center;
    gap: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.4s var(--ease-out-expo);
    flex-shrink: 0;
  }

  .prompt-link:hover {
    opacity: 0.65;
  }

  .prompt-user {
    color: var(--theme-accent);
    font-weight: 600;
  }

  .prompt-sep,
  .prompt-colon {
    color: var(--theme-text-secondary);
  }

  .prompt-host {
    color: var(--theme-accent);
  }

  .prompt-path {
    color: var(--theme-text-secondary);
    font-weight: 500;
  }

  /* ═══ PILL DIVIDER ═══ */
  .pill-divider {
    width: 1px;
    height: 16px;
    background: var(--theme-border);
    flex-shrink: 0;
    transition: background-color 0.3s ease;
  }

  /* ═══ DESKTOP NAV LINKS ═══ */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pill-link {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 9999px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--theme-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.4s var(--ease-out-expo),
      background-color 0.4s var(--ease-out-expo);
    letter-spacing: 0.01em;
  }

  .pill-link:hover {
    color: var(--theme-accent);
    background: rgba(15, 76, 92, 0.06);
  }

  body.dark .pill-link:hover {
    background: rgba(92, 188, 208, 0.08);
  }

  .pill-link.active {
    color: var(--theme-accent);
    background: rgba(15, 76, 92, 0.1);
    font-weight: 600;
  }

  body.dark .pill-link.active {
    background: rgba(92, 188, 208, 0.12);
  }

  /* ═══ SOCIAL ICONS ═══ */
  .pill-socials {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pill-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--theme-text-secondary);
    transition:
      color 0.4s var(--ease-out-expo),
      background-color 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }

  .pill-social-icon:hover {
    color: var(--theme-accent);
    background: rgba(15, 76, 92, 0.06);
    transform: scale(1.1);
  }

  body.dark .pill-social-icon:hover {
    background: rgba(92, 188, 208, 0.08);
  }

  /* ═══ HAMBURGER ═══ */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .hamburger-line {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--theme-text-primary);
    border-radius: 1px;
    transition: transform 0.5s var(--ease-out-expo);
    transform-origin: center;
  }

  .hamburger.active .hamburger-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .hamburger.active .hamburger-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ═══ MOBILE OVERLAY ═══ */
  /* Sits below the pill (z-50) so the hamburger stays tappable while open. */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(250, 248, 245, 0.94);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.5s var(--ease-out-expo),
      visibility 0s linear 0.5s;
  }

  body.dark .mobile-overlay {
    background: rgba(6, 6, 9, 0.94);
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      visibility 0s linear 0s;
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    /* Landscape phones are short enough to overflow the centred stack. */
    max-height: 100%;
    overflow-y: auto;
    gap: 24px;
    padding: 80px 24px;
  }

  .overlay-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 28px;
    font-weight: 600;
    color: var(--theme-text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo),
      color 0.3s ease;
    transition-delay: calc(var(--i) * 80ms + 150ms);
  }

  .mobile-overlay.active .overlay-link {
    opacity: 1;
    transform: translateY(0);
  }

  .overlay-link:hover {
    color: var(--theme-accent);
  }

  .overlay-socials {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
    transition-delay: calc(var(--i) * 80ms + 150ms);
  }

  .mobile-overlay.active .overlay-socials {
    opacity: 1;
    transform: translateY(0);
  }

  .overlay-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--theme-border);
    color: var(--theme-text-secondary);
    transition:
      color 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }

  .overlay-social-icon:hover {
    color: var(--theme-accent);
    border-color: var(--theme-accent);
    transform: scale(1.1);
  }

  /* ═══ RESPONSIVE ═══ */
  /* Just above the mobile breakpoint the full pill barely clears its gutter —
     tighten spacing until there is room for the default metrics. */
  @media (min-width: 769px) and (max-width: 900px) {
    .glass-pill {
      gap: 8px;
      padding: 8px 14px;
    }

    .desktop-nav {
      gap: 2px;
    }

    .pill-link {
      padding: 4px 7px;
    }

    .pill-socials {
      gap: 4px;
    }

    .pill-social-icon {
      width: 24px;
      height: 24px;
    }
  }

  @media (max-width: 768px) {
    .glass-pill {
      gap: 10px;
      padding: 8px 16px;
    }

    .desktop-nav,
    .desktop-only {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  const glassPill = document.getElementById('glass-pill');
  const scrollTopBtn = document.getElementById('scroll-top-btn');
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileOverlay = document.getElementById('mobile-overlay');

  // Scroll to top
  scrollTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  const isMenuOpen = () => mobileOverlay?.classList.contains('active') ?? false;

  function openMenu() {
    hamburgerBtn?.classList.add('active');
    mobileOverlay?.classList.add('active');
    hamburgerBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu({ restoreFocus = false } = {}) {
    hamburgerBtn?.classList.remove('active');
    mobileOverlay?.classList.remove('active');
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (restoreFocus) hamburgerBtn?.focus();
  }

  hamburgerBtn?.addEventListener('click', () => {
    isMenuOpen() ? closeMenu() : openMenu();
  });

  // Every link closes the menu — section links and socials alike. Socials open a
  // new tab, so without this the menu (and the body scroll lock) survive the trip.
  mobileOverlay?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => closeMenu());
  });

  document.addEventListener('keydown', (e) => {
    if (!isMenuOpen()) return;

    if (e.key === 'Escape') {
      closeMenu({ restoreFocus: true });
      return;
    }

    if (e.key !== 'Tab') return;

    // Trap focus: the hamburger is the only control outside the overlay that
    // stays reachable, so it bookends the loop as the close affordance.
    const focusables = [
      ...(mobileOverlay?.querySelectorAll('a') ?? []),
      hamburgerBtn,
    ].filter(Boolean);
    if (!focusables.length) return;

    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;

    if (e.shiftKey && (active === first || !focusables.includes(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Resizing past the breakpoint hides the hamburger; without this the overlay
  // and scroll lock would be stranded with no way to dismiss them.
  window.addEventListener('resize', () => {
    if (isMenuOpen() && window.innerWidth > 768) closeMenu();
  });

  // Scroll direction tracking: hide on down, reveal on up
  const siteHeader = document.getElementById('site-header');
  let lastScrollY = window.scrollY;
  let ticking = false;
  const SCROLL_THRESHOLD = 10; // Ignore tiny scroll movements

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const currentScrollY = window.scrollY;
        const delta = currentScrollY - lastScrollY;

        // Glass pill "scrolled" state
        if (currentScrollY > 50) {
          glassPill?.classList.add('scrolled');
        } else {
          glassPill?.classList.remove('scrolled');
        }

        // Show/hide based on scroll direction
        if (currentScrollY <= 50) {
          // Always show near the top
          siteHeader?.classList.remove('header-hidden');
          siteHeader?.classList.add('header-visible');
        } else if (delta > SCROLL_THRESHOLD) {
          // Scrolling down — hide
          siteHeader?.classList.add('header-hidden');
          siteHeader?.classList.remove('header-visible');
        } else if (delta < -SCROLL_THRESHOLD) {
          // Scrolling up — show
          siteHeader?.classList.remove('header-hidden');
          siteHeader?.classList.add('header-visible');
        }

        lastScrollY = currentScrollY;
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Active section observer
  const sections = ['about', 'projects', 'experience', 'education', 'references', 'github'];
  const navLinks = document.querySelectorAll('[data-nav]');

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navLinks.forEach((link) => {
          if (link.getAttribute('data-nav') === id) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    });
  }, {
    root: null,
    rootMargin: '-50% 0px -50% 0px',
    threshold: 0,
  });

  sections.forEach((section) => {
    const element = document.getElementById(section);
    if (element) sectionObserver.observe(element);
  });
</script>

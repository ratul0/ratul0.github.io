---
import { siteConfig } from "../config";
import { Icon } from "astro-icon/components";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const hasReferences = siteConfig.references && siteConfig.references.length > 0;

// Social links defined once, rendered in both desktop pill and mobile overlay
const socialLinks = [
  siteConfig.social?.email && { href: `mailto:${siteConfig.social.email}`, label: "Email", icon: "simple-icons:gmail" },
  siteConfig.social?.linkedin && { href: siteConfig.social.linkedin, label: "LinkedIn", icon: "simple-icons:linkedin", external: true },
  siteConfig.social?.medium && { href: siteConfig.social.medium, label: "Medium", icon: "simple-icons:medium", external: true },
  siteConfig.social?.resume && { href: siteConfig.social.resume, label: "Resume", icon: "simple-icons:readdotcv", external: true },
  siteConfig.social?.github && { href: siteConfig.social.github, label: "GitHub", icon: "simple-icons:github", external: true },
].filter(Boolean) as { href: string; label: string; icon: string; external?: boolean }[];
---

<!-- Floating Glass Pill Navigation -->
<header class="fixed top-0 left-0 right-0 z-50 pointer-events-none">
  <div class="flex justify-center pt-5 px-4">
    <nav id="glass-pill" class="glass-pill pointer-events-auto">
      <!-- Terminal prompt / logo -->
      <button id="scroll-top-btn" class="prompt-link" aria-label="Scroll to top">
        <span class="prompt-user">yousuf</span><span class="prompt-sep">@</span><span class="prompt-host">khan</span><span class="prompt-colon">:</span><span class="prompt-path">~</span>
      </button>

      <!-- Divider -->
      <div class="pill-divider desktop-only"></div>

      <!-- Desktop navigation links -->
      <div class="desktop-nav">
        <a href="#about" data-nav="about" class="pill-link">about</a>
        {hasProjects && <a href="#projects" data-nav="projects" class="pill-link">projects</a>}
        {hasExperience && <a href="#experience" data-nav="experience" class="pill-link">experience</a>}
        {hasEducation && <a href="#education" data-nav="education" class="pill-link">education</a>}
        {hasReferences && <a href="#references" data-nav="references" class="pill-link">references</a>}
      </div>

      <!-- Divider -->
      <div class="pill-divider desktop-only"></div>

      <!-- Social icons (desktop) -->
      <div class="pill-socials desktop-only">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            aria-label={link.label}
            class="pill-social-icon"
          >
            <Icon name={link.icon} width="13" height="13" />
          </a>
        ))}
      </div>

      <!-- Mobile hamburger -->
      <button id="hamburger-btn" class="hamburger" aria-label="Toggle menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile full-screen overlay -->
  <div id="mobile-overlay" class="mobile-overlay">
    <nav class="overlay-content">
      <a href="#about" class="overlay-link" style="--i: 0">about</a>
      {hasProjects && <a href="#projects" class="overlay-link" style="--i: 1">projects</a>}
      {hasExperience && <a href="#experience" class="overlay-link" style="--i: 1">experience</a>}
      {hasEducation && <a href="#education" class="overlay-link" style="--i: 2">education</a>}
      {hasReferences && <a href="#references" class="overlay-link" style="--i: 3">references</a>}

      <!-- Social icons in overlay -->
      <div class="overlay-socials" style="--i: 4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            aria-label={link.label}
            class="overlay-social-icon"
          >
            <Icon name={link.icon} width="20" height="20" />
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  /* ═══ GLASS PILL ═══ */
  .glass-pill {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 20px;
    border-radius: 9999px;
    background: rgba(250, 248, 245, 0.72);
    border: 1px solid rgba(232, 228, 223, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.03),
      0 1px 2px rgba(0, 0, 0, 0.02);
    transition:
      background 0.7s var(--ease-out-expo),
      box-shadow 0.7s var(--ease-out-expo),
      border-color 0.7s var(--ease-out-expo);
  }

  body.dark .glass-pill {
    background: rgba(6, 6, 9, 0.72);
    border-color: rgba(30, 36, 48, 0.8);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.2),
      0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .glass-pill.scrolled {
    background: rgba(250, 248, 245, 0.92);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
  }

  body.dark .glass-pill.scrolled {
    background: rgba(6, 6, 9, 0.92);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  /* ═══ PROMPT / LOGO ═══ */
  .prompt-link {
    display: flex;
    align-items: center;
    gap: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.4s var(--ease-out-expo);
    flex-shrink: 0;
  }

  .prompt-link:hover {
    opacity: 0.65;
  }

  .prompt-user {
    color: var(--theme-accent);
    font-weight: 600;
  }

  .prompt-sep,
  .prompt-colon {
    color: var(--theme-text-secondary);
  }

  .prompt-host {
    color: var(--theme-accent);
  }

  .prompt-path {
    color: var(--theme-text-secondary);
    font-weight: 500;
  }

  /* ═══ PILL DIVIDER ═══ */
  .pill-divider {
    width: 1px;
    height: 16px;
    background: var(--theme-border);
    flex-shrink: 0;
    transition: background-color 0.3s ease;
  }

  /* ═══ DESKTOP NAV LINKS ═══ */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pill-link {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 9999px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--theme-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.4s var(--ease-out-expo),
      background-color 0.4s var(--ease-out-expo);
    letter-spacing: 0.01em;
  }

  .pill-link:hover {
    color: var(--theme-accent);
    background: rgba(15, 76, 92, 0.06);
  }

  body.dark .pill-link:hover {
    background: rgba(92, 188, 208, 0.08);
  }

  .pill-link.active {
    color: var(--theme-accent);
    background: rgba(15, 76, 92, 0.1);
    font-weight: 600;
  }

  body.dark .pill-link.active {
    background: rgba(92, 188, 208, 0.12);
  }

  /* ═══ SOCIAL ICONS ═══ */
  .pill-socials {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pill-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--theme-text-secondary);
    transition:
      color 0.4s var(--ease-out-expo),
      background-color 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }

  .pill-social-icon:hover {
    color: var(--theme-accent);
    background: rgba(15, 76, 92, 0.06);
    transform: scale(1.1);
  }

  body.dark .pill-social-icon:hover {
    background: rgba(92, 188, 208, 0.08);
  }

  /* ═══ HAMBURGER ═══ */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .hamburger-line {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--theme-text-primary);
    border-radius: 1px;
    transition: transform 0.5s var(--ease-out-expo);
    transform-origin: center;
  }

  .hamburger.active .hamburger-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .hamburger.active .hamburger-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ═══ MOBILE OVERLAY ═══ */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(250, 248, 245, 0.94);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  body.dark .mobile-overlay {
    background: rgba(6, 6, 9, 0.94);
  }

  .mobile-overlay.active {
    opacity: 1;
    pointer-events: all;
    z-index: 40;
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 24px;
    padding: 80px 24px;
  }

  .overlay-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 28px;
    font-weight: 600;
    color: var(--theme-text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo),
      color 0.3s ease;
    transition-delay: calc(var(--i) * 80ms + 150ms);
  }

  .mobile-overlay.active .overlay-link {
    opacity: 1;
    transform: translateY(0);
  }

  .overlay-link:hover {
    color: var(--theme-accent);
  }

  .overlay-socials {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
    transition-delay: calc(var(--i) * 80ms + 150ms);
  }

  .mobile-overlay.active .overlay-socials {
    opacity: 1;
    transform: translateY(0);
  }

  .overlay-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--theme-border);
    color: var(--theme-text-secondary);
    transition:
      color 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }

  .overlay-social-icon:hover {
    color: var(--theme-accent);
    border-color: var(--theme-accent);
    transform: scale(1.1);
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 768px) {
    .glass-pill {
      gap: 10px;
      padding: 8px 16px;
    }

    .desktop-nav,
    .desktop-only {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  const glassPill = document.getElementById('glass-pill');
  const scrollTopBtn = document.getElementById('scroll-top-btn');
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileOverlay = document.getElementById('mobile-overlay');

  // Scroll to top
  scrollTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Hamburger toggle
  hamburgerBtn?.addEventListener('click', () => {
    hamburgerBtn.classList.toggle('active');
    mobileOverlay?.classList.toggle('active');
    document.body.style.overflow = mobileOverlay?.classList.contains('active') ? 'hidden' : '';
  });

  // Close overlay on link click
  const overlayLinks = document.querySelectorAll('.overlay-link');
  overlayLinks.forEach(link => {
    link.addEventListener('click', () => {
      hamburgerBtn?.classList.remove('active');
      mobileOverlay?.classList.remove('active');
      document.body.style.overflow = '';
    });
  });

  // Scroll state for glass pill (passive for performance)
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        if (window.scrollY > 50) {
          glassPill?.classList.add('scrolled');
        } else {
          glassPill?.classList.remove('scrolled');
        }
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Active section observer
  const sections = ['about', 'projects', 'experience', 'education', 'references'];
  const navLinks = document.querySelectorAll('[data-nav]');

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navLinks.forEach((link) => {
          if (link.getAttribute('data-nav') === id) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    });
  }, {
    root: null,
    rootMargin: '-50% 0px -50% 0px',
    threshold: 0,
  });

  sections.forEach((section) => {
    const element = document.getElementById(section);
    if (element) sectionObserver.observe(element);
  });
</script>

---
import { lenses } from "../lib/lens";
---

<!-- Pressed styling is CSS-driven from html[data-lens] (see lensCss); scripts/lens.ts keeps aria-pressed in sync. -->
<div class="lens-switcher" role="group" aria-label="Tailor this page to a role" data-lens-switcher>
  <span class="lens-switcher-label">
    <svg class="lens-aperture" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" data-lens-aperture>
      <circle cx="12" cy="12" r="10" />
      <path d="M14.3 2.3 8.1 13M21.7 9.6H9.4M19.4 18.1 13.3 7.4M9.7 21.7 15.9 11M2.3 14.4h12.3M4.6 5.9l6.1 10.7" />
    </svg>
    <span>Lens</span>
  </span>
  <button type="button" class="lens-btn" data-lens-id="" aria-pressed="true">All</button>
  {lenses.map((lens) => (
    <button type="button" class="lens-btn" data-lens-id={lens.id} aria-pressed="false">{lens.label}</button>
  ))}
</div>

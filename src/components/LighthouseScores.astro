---
let scores: Record<string, number> | null = null;
try {
  const data = await import("../data/lighthouse.json");
  if (data.scores) scores = data.scores;
} catch {
  /* section won't render */
}

const CIRCUMFERENCE = 2 * Math.PI * 52; // ~326.73

function getColor(score: number): string {
  if (score >= 90) return "#0cce6b";
  if (score >= 50) return "#ffa400";
  return "#ff4e42";
}

const hasScores =
  scores && Object.values(scores).some((v: number) => v > 0);

const gauges = hasScores
  ? [
      { key: "performance", label: "Performance" },
      { key: "accessibility", label: "Accessibility" },
      { key: "bestPractices", label: "Best Practices" },
      { key: "seo", label: "SEO" },
    ].map((cat, i) => {
      const score = scores![cat.key] ?? 0;
      const color = getColor(score);
      const offset = CIRCUMFERENCE * (1 - score / 100);
      return { ...cat, score, color, offset, index: i };
    })
  : [];
---

{
  hasScores && (
    <section
      id="lighthouse"
      class="relative py-32 md:py-40 px-6 md:px-12 lg:px-16"
    >
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          {/* Left column - Sticky header */}
          <div class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start">
            <div class="space-y-4 scroll-reveal">
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
                Lighthouse
              </h2>
              <div class="accent-line animate h-3" />
              <a
                href="https://pagespeed.web.dev/analysis?url=https://ratul0.github.io&form_factor=desktop"
                target="_blank"
                rel="noopener noreferrer"
                class="section-link"
              >
                Verify scores ↗
              </a>
            </div>
          </div>

          {/* Right column - Gauges */}
          <div class="lg:col-span-8">
            <div class="scroll-reveal" data-delay="1">
              <div class="bezel">
                <div class="bezel-inner p-6 md:p-8">
                  <div class="gauge-grid">
                    {gauges.map((g) => (
                      <div
                        class="gauge"
                        data-score={g.score}
                        data-color={g.color}
                        data-index={g.index}
                      >
                        <div class="gauge-svg-wrap">
                          <svg
                            class="gauge-svg"
                            viewBox="0 0 120 120"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <circle
                              cx="60"
                              cy="60"
                              r="52"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="5"
                              class="gauge-track"
                            />
                            <circle
                              cx="60"
                              cy="60"
                              r="52"
                              fill="none"
                              stroke={g.color}
                              stroke-width="5"
                              stroke-linecap="round"
                              class="gauge-ring"
                              transform="rotate(-90 60 60)"
                            />
                          </svg>
                          <span class="gauge-score">0</span>
                        </div>
                        <span class="gauge-label">{g.label}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .gauge-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .gauge-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1rem;
    }
  }

  .gauge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .gauge-svg-wrap {
    position: relative;
    width: 100%;
    max-width: 120px;
  }

  .gauge-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .gauge-track {
    opacity: 0.15;
  }

  .gauge-ring {
    stroke-dasharray: 326.73;
    stroke-dashoffset: 326.73;
    transition: none;
  }

  .gauge-score {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 700;
    font-family: "IBM Plex Mono", monospace;
    color: var(--theme-text-primary);
  }

  .gauge-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--theme-text-secondary);
    text-align: center;
  }
</style>

<script>
  let currentObserver: IntersectionObserver | null = null;

  function animateGauges() {
    if (currentObserver) {
      currentObserver.disconnect();
      currentObserver = null;
    }

    const grid = document.querySelector(".gauge-grid");
    if (!grid) return;

    const gauges = grid.querySelectorAll<HTMLElement>(".gauge");

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (entry.isIntersecting) {
          observer.disconnect();
          currentObserver = null;

          gauges.forEach((gauge) => {
              const score = parseInt(gauge.dataset.score || "0", 10);
              const color = gauge.dataset.color || "#0cce6b";
              const index = parseInt(gauge.dataset.index || "0", 10);
              const delay = index * 150;

              const ring = gauge.querySelector<SVGCircleElement>(".gauge-ring");
              const scoreEl = gauge.querySelector<HTMLElement>(".gauge-score");
              if (!ring || !scoreEl) return;

              const circumference = 326.73;
              const finalOffset = circumference * (1 - score / 100);

              setTimeout(() => {
                // Animate ring
                ring.style.stroke = color;
                ring.style.transition = `stroke-dashoffset 1.2s cubic-bezier(0.32, 0.72, 0, 1)`;
                ring.style.strokeDashoffset = `${finalOffset}`;

                // Animate count
                const duration = 1200;
                const start = performance.now();

                function updateCount(now: number) {
                  const elapsed = now - start;
                  const progress = Math.min(elapsed / duration, 1);
                  // ease-out cubic
                  const eased = 1 - Math.pow(1 - progress, 3);
                  const current = Math.round(eased * score);
                  scoreEl!.textContent = String(current);

                  if (progress < 1) {
                    requestAnimationFrame(updateCount);
                  }
                }

                requestAnimationFrame(updateCount);
              }, delay);
            });
        }
      },
      { threshold: 0.3 }
    );

    currentObserver = observer;
    observer.observe(grid);
  }

  // Run on load and after Astro page transitions
  animateGauges();
  document.addEventListener("astro:after-swap", animateGauges);
</script>

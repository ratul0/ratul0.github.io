---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
import LensText from "./LensText.astro";
import { lensMatch, lensOrderStyle, placeMarks } from "../lib/lens";
import { BEAT_COUNT, getProjectProof, type Beat } from "../lib/proof";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const count = String(siteConfig.projects.length).padStart(2, "0");

const proofs = await getProjectProof();

// App proof older than this is labelled "last checked"; the builds refresh it every 6 hours.
const STALE_AFTER_MS = 7 * 24 * 60 * 60 * 1000;
// A site whose newest heartbeat is older than this shows "no recent data" instead of a status.
const IDLE_AFTER_MS = 10 * 60 * 1000;
const RATING_MIN_COUNT = 5;

const formatDate = (iso: string) => {
  const parts = Object.fromEntries(
    new Intl.DateTimeFormat("en-US", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })
      .formatToParts(new Date(iso))
      .map((part) => [part.type, part.value]),
  );
  return `${parts.day} ${parts.month} ${parts.year}`;
};

const SITE_STATES = {
  up: { label: "operational", dot: "available" },
  down: { label: "down", dot: "down" },
  idle: { label: "no recent data", dot: "idle" },
} as const;

// Build-time titles are UTC; the client script rewrites them in the visitor's local time.
const beatTitle = (beat: Beat) =>
  `${beat.time.slice(11, 16)} UTC · ${beat.status === 1 ? "up" : "down"}${beat.ping === null ? "" : ` · ${beat.ping}ms`}`;
---

{
  hasProjects && (
    <section id="projects" class="relative py-32 md:py-40 px-6 md:px-12 lg:px-16">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-16">
          <!-- Left column - Sticky header -->
          <div class="xl:col-span-4 xl:sticky xl:top-32 xl:self-start">
            <div class="space-y-4 scroll-reveal">
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
                Projects
              </h2>
              <div class="accent-line animate h-3"></div>
              <p class="text-sm md:text-base text-[var(--theme-text-secondary)] leading-relaxed max-w-sm pt-2">
                Products I design, build and run on my own.
              </p>
              <p class="text-xs uppercase tracking-widest text-[var(--theme-text-secondary)]">
                <span class="text-[var(--theme-accent)] mr-2">&gt;</span>{count} shipped
              </p>
            </div>
          </div>

          <!-- Right column - Ledger cards -->
          <div class="xl:col-span-8">
            <div class="flex flex-col gap-6">
              {siteConfig.projects.map((project, index) => {
                // Lens highlights can land in the description or any bullet.
                const [descriptionMarks, ...highlightMarks] = placeMarks(
                  [project.description, ...project.highlights],
                  project.lenses,
                  project.name,
                );

                const proof = proofs[project.name];
                const stale = proof?.kind === "app" && Date.now() - new Date(proof.fetchedAt).getTime() > STALE_AFTER_MS;
                const showRating =
                  proof?.kind === "app" && proof.rating !== undefined && (proof.ratingCount ?? 0) >= RATING_MIN_COUNT;

                // Newest on the right; missing slots on the left stay empty.
                const beats = proof?.kind === "site" ? (proof.beats ?? []).slice(-BEAT_COUNT) : [];
                const slots = Array.from({ length: BEAT_COUNT }, (_, i) => beats[i - (BEAT_COUNT - beats.length)]);
                const newest = beats.at(-1);
                const siteState =
                  !newest || Date.now() - Date.parse(newest.time) > IDLE_AFTER_MS ? "idle" : newest.status === 1 ? "up" : "down";

                return (
                <div
                  class="project-card-wrapper scroll-reveal"
                  data-delay={String(Math.min(index + 1, 4))}
                  data-lens-sort
                  data-lens-match={lensMatch(project.lenses, project.name)}
                  style={`--rotation: ${index % 2 === 0 ? "-0.4deg" : "0.3deg"};${lensOrderStyle(project.lenses) ?? ""}`}
                >
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block"
                  >
                    <div class="bezel project-card">
                      <div class="bezel-inner p-6 md:p-8">
                        <!-- Top row -->
                        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-5">
                          <div class="flex items-start gap-4 md:gap-5 min-w-0">
                            <span class="project-index" aria-hidden="true">
                              {String(index + 1).padStart(2, "0")}
                            </span>
                            <div class="min-w-0">
                              <h3 class="text-xl md:text-2xl font-semibold text-[var(--theme-accent)]">
                                {project.name}
                              </h3>
                              <p class="text-base text-[var(--theme-text-primary)] mt-1">
                                {project.tagline}
                              </p>
                            </div>
                          </div>
                          <div class="flex items-center gap-3 flex-shrink-0 flex-wrap">
                            <span class="text-xs font-light uppercase tracking-widest text-[var(--theme-text-secondary)]">
                              {project.dateRange}
                            </span>
                            <span
                              class="eyebrow inline-flex items-center gap-2 text-[var(--theme-accent)] border-[var(--theme-accent)]"
                              style="font-size: 9px; padding: 3px 10px;"
                            >
                              <span class="status-dot available"></span>
                              {project.status}
                            </span>
                          </div>
                        </div>

                        <!-- Meta line -->
                        <p class="text-xs uppercase tracking-wider text-[var(--theme-text-secondary)] mb-4">
                          {project.kind}
                          {project.linkLabel && <span> · {project.linkLabel}</span>}
                        </p>

                        <!-- Description -->
                        <p class="text-sm md:text-base text-[var(--theme-text-secondary)] leading-relaxed mb-5">
                          <LensText text={project.description} marks={descriptionMarks} />
                        </p>

                        <!-- Highlights -->
                        <ul class="space-y-3">
                          {project.highlights.map((item, i) => (
                            <li class="flex items-start gap-3 text-sm md:text-base text-[var(--theme-text-secondary)] leading-relaxed">
                              <span class="text-[var(--theme-accent)] font-light mt-0.5 flex-shrink-0">&gt;</span>
                              <span><LensText text={item} marks={highlightMarks[i]} /></span>
                            </li>
                          ))}
                        </ul>

                        <!-- Link unfurl -->
                        <div class="project-unfurl mt-6 flex flex-col sm:flex-row rounded-xl overflow-hidden">
                          {project.image && (
                            <Image
                              src={project.image}
                              alt={project.imageAlt ?? ""}
                              widths={[320, 480, 640, 960]}
                              sizes="(min-width: 768px) 288px, (min-width: 640px) 224px, 100vw"
                              loading="lazy"
                              decoding="async"
                              class="project-unfurl-img w-full sm:w-56 md:w-72 sm:shrink-0 aspect-video object-cover block"
                            />
                          )}
                          <div class="flex items-center gap-4 p-4 min-w-0 flex-1">
                            <div class="min-w-0 flex-1 space-y-1">
                              {project.linkLabel && (
                                <p class="text-xs uppercase tracking-widest text-[var(--theme-text-secondary)]">
                                  {project.linkLabel}
                                </p>
                              )}
                              <p class="project-unfurl-title text-sm font-medium text-[var(--theme-text-primary)]">
                                {project.name} — {project.tagline}
                              </p>
                              {proof?.kind === "site" ? (
                                <div
                                  class="proof-site pt-1 space-y-2"
                                  data-newest={newest?.time}
                                  data-newest-status={newest?.status}
                                >
                                  <div
                                    class="proof-strip"
                                    aria-hidden="true"
                                    title="Live from Uptime Kuma, checked every minute"
                                    data-kuma-heartbeat={`${siteConfig.proof.kuma}/api/status-page/heartbeat/${siteConfig.proof.statusPage}`}
                                    data-monitor={(project.proof as { kumaMonitor?: number } | undefined)?.kumaMonitor}
                                    data-slots={BEAT_COUNT}
                                  >
                                    {slots.map((beat) =>
                                      beat ? (
                                        <span
                                          class:list={["proof-bar", beat.status === 1 ? "up" : "down"]}
                                          title={beatTitle(beat)}
                                          data-time={beat.time}
                                        ></span>
                                      ) : (
                                        <span class="proof-bar empty"></span>
                                      ),
                                    )}
                                  </div>
                                  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--theme-text-secondary)]">
                                    <span class="inline-flex items-center gap-2">
                                      <span class:list={["status-dot", SITE_STATES[siteState].dot]} data-proof-dot></span>
                                      <span data-proof-label>{SITE_STATES[siteState].label}</span>
                                    </span>
                                    {proof.uptime30d !== undefined && <span>{proof.uptime30d}% 30d</span>}
                                    {proof.avgResponseMs !== undefined && <span>{proof.avgResponseMs}ms avg</span>}
                                    <span data-proof-checked hidden={!newest}>
                                      {newest && `checked ${newest.time.slice(11, 16)} UTC`}
                                    </span>
                                  </p>
                                </div>
                              ) : proof?.kind === "app" ? (
                                <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-[var(--theme-text-secondary)] pt-0.5">
                                  <span class="proof-pill">v{proof.version}</span>
                                  <span class="inline-flex items-center gap-2">
                                    <span class="status-dot available"></span>
                                    <span>
                                      shipped <time datetime={proof.releasedAt} data-shipped>{formatDate(proof.releasedAt)}</time>
                                    </span>
                                  </span>
                                  {showRating && <span>★ {proof.rating!.toFixed(1)} ({proof.ratingCount})</span>}
                                  {stale && <span>last checked {formatDate(proof.fetchedAt)}</span>}
                                </p>
                              ) : (
                                <p class="text-xs text-[var(--theme-text-secondary)] truncate">
                                  {project.description}
                                </p>
                              )}
                            </div>
                            <span class="arrow-badge w-7 h-7 flex-shrink-0 group-hover:translate-x-0.5 group-hover:-translate-y-px">
                              <svg width="10" height="10" viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 7L7 1M7 1H3M7 1V5" />
                              </svg>
                            </span>
                          </div>
                        </div>

                        <!-- Skills -->
                        <div class="border-t border-[var(--theme-border)] pt-5 mt-6">
                          <div class="flex flex-wrap gap-2">
                            {project.skills.map((skill) => (
                              <span class="skill-pill text-xs">{skill}</span>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .project-card-wrapper {
    transition: transform 0.7s var(--ease-out-expo);
  }

  .project-card {
    transform: rotate(var(--rotation, 0deg));
    transition: all 0.7s var(--ease-out-expo);
  }

  .project-card-wrapper a:hover .project-card,
  .project-card-wrapper a:focus-visible .project-card {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.08);
  }

  :global(body.dark) .project-card-wrapper a:hover .project-card,
  :global(body.dark) .project-card-wrapper a:focus-visible .project-card {
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
  }

  .project-unfurl {
    border: 1px solid var(--theme-border);
    background: color-mix(in srgb, var(--theme-text-primary) 3%, transparent);
    transition: border-color 0.5s var(--ease-out-expo);
  }

  .group:hover .project-unfurl,
  .group:focus-visible .project-unfurl {
    border-color: var(--theme-accent);
  }

  .project-unfurl-img {
    border-bottom: 1px solid var(--theme-border);
  }

  @media (min-width: 640px) {
    .project-unfurl-img {
      border-bottom: 0;
      border-right: 1px solid var(--theme-border);
    }
  }

  .project-unfurl-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Small outlined index number, echoing .section-number */
  .project-index {
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--theme-accent);
    opacity: 0.4;
    flex-shrink: 0;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .project-card-wrapper a:hover .project-index {
    opacity: 0.8;
  }

  /* Remove rotation on mobile for touch-friendliness */
  @media (max-width: 768px) {
    .project-card {
      transform: rotate(0deg);
    }
  }
</style>

<script>
  // The strips and the release time are fully rendered at build time; this keeps them live.
  const IDLE_AFTER_MS = 10 * 60 * 1000;
  const POLL_MS = 60 * 1000;
  const DAY_MS = 24 * 60 * 60 * 1000;

  const SITE_STATES = {
    up: { label: "operational", dot: "available" },
    down: { label: "down", dot: "down" },
    idle: { label: "no recent data", dot: "idle" },
  } as const;

  interface Beat {
    status: number;
    time: string;
    ping?: number | null;
  }

  const pad = (n: number) => String(n).padStart(2, "0");
  const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });

  // Kuma sends UTC times without a zone: "2026-10-24 19:35:07.363".
  const parseBeatTime = (time: string) => new Date(`${time.replace(" ", "T")}Z`);

  const ago = (ms: number) => {
    const seconds = Math.max(0, Math.floor(ms / 1000));
    if (seconds < 60) return `${seconds}s ago`;
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    return hours < 24 ? `${hours}h ago` : `${Math.floor(hours / 24)}d ago`;
  };

  const localTime = (date: Date) =>
    date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hourCycle: "h23" });

  // --- Heartbeat strips ---

  const sites = [...document.querySelectorAll<HTMLElement>(".proof-site")].flatMap((site) => {
    const strip = site.querySelector<HTMLElement>(".proof-strip[data-kuma-heartbeat]");
    const dot = site.querySelector<HTMLElement>("[data-proof-dot]");
    const label = site.querySelector<HTMLElement>("[data-proof-label]");
    const checked = site.querySelector<HTMLElement>("[data-proof-checked]");
    if (!strip || !dot || !label || !checked) return [];
    return [{ site, strip, dot, label, checked, url: strip.dataset.kumaHeartbeat!, monitor: strip.dataset.monitor!, slots: Number(strip.dataset.slots) }];
  });

  // Dot, label and "checked … ago" all derive from the newest beat, so they also go stale honestly if polling fails.
  const renderMeta = ({ site, dot, label, checked }: (typeof sites)[number]) => {
    const newest = site.dataset.newest ? new Date(site.dataset.newest).getTime() : NaN;
    if (Number.isNaN(newest)) return;
    const age = Date.now() - newest;
    const state = age > IDLE_AFTER_MS ? "idle" : site.dataset.newestStatus === "1" ? "up" : "down";
    dot.className = `status-dot ${SITE_STATES[state].dot}`;
    label.textContent = SITE_STATES[state].label;
    checked.hidden = false;
    checked.textContent = `checked ${ago(age)}`;
  };

  const renderStrip = (entry: (typeof sites)[number], list: Beat[]) => {
    const beats = list.slice(-entry.slots).flatMap((beat) => {
      const date = parseBeatTime(beat.time);
      return Number.isNaN(date.getTime()) ? [] : [{ beat, date }];
    });
    if (beats.length === 0) return;

    // Bars already on the page (from the build or an earlier poll) don't animate again.
    const known = new Set(Array.from(entry.strip.children, (bar) => (bar as HTMLElement).dataset.time));
    const bars: HTMLElement[] = [];
    for (let i = 0; i < entry.slots - beats.length; i++) {
      const bar = document.createElement("span");
      bar.className = "proof-bar empty";
      bars.push(bar);
    }
    for (const { beat, date } of beats) {
      const iso = date.toISOString();
      const bar = document.createElement("span");
      bar.className = `proof-bar ${beat.status === 1 ? "up" : "down"}${known.has(iso) ? "" : " new"}`;
      bar.dataset.time = iso;
      bar.title = `${localTime(date)} · ${beat.status === 1 ? "up" : "down"}${typeof beat.ping === "number" ? ` · ${beat.ping}ms` : ""}`;
      bars.push(bar);
    }
    entry.strip.replaceChildren(...bars);

    const newest = beats[beats.length - 1];
    entry.site.dataset.newest = newest.date.toISOString();
    entry.site.dataset.newestStatus = newest.beat.status === 1 ? "1" : "0";
    renderMeta(entry);
  };

  // Strips on the same status page share one request.
  const poll = async () => {
    for (const url of new Set(sites.map((entry) => entry.url))) {
      try {
        const response = await fetch(url, { cache: "no-store", signal: AbortSignal.timeout(8000) });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const { heartbeatList } = await response.json();
        for (const entry of sites) {
          if (entry.url === url && Array.isArray(heartbeatList?.[entry.monitor])) renderStrip(entry, heartbeatList[entry.monitor]);
        }
      } catch {
        // Keep what's rendered; the ticking counter keeps showing the true age.
      }
    }
  };

  // --- Release pulse ---

  const shipped = [...document.querySelectorAll<HTMLTimeElement>("time[data-shipped]")].flatMap((el) => {
    const then = new Date(el.dateTime).getTime();
    return Number.isNaN(then) ? [] : [{ el, then }];
  });

  const renderShipped = ({ el, then }: (typeof shipped)[number]) => {
    const age = Math.max(0, Date.now() - then);
    const days = Math.floor(age / DAY_MS);
    if (days >= 30) {
      el.textContent = days < 365 ? rtf.format(-Math.floor(days / 30), "month") : rtf.format(-Math.floor(days / 365), "year");
      return;
    }
    const hours = Math.floor((age % DAY_MS) / 3_600_000);
    const minutes = Math.floor((age % 3_600_000) / 60_000);
    const parts = `${hours}h ${pad(minutes)}m`;
    el.textContent = `${days > 0 ? `${days}d ` : ""}${parts} ago`;
  };

  // --- Wiring ---

  const tick = () => {
    sites.forEach(renderMeta);
    shipped.forEach(renderShipped);
  };

  if (sites.length > 0) {
    let timer: number | undefined;
    const start = () => {
      if (timer !== undefined) return;
      poll();
      timer = window.setInterval(poll, POLL_MS);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    // No polling in background tabs; catch up immediately on return.
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    if (!document.hidden) start();
  }

  tick();
  setInterval(tick, 1000);
</script>

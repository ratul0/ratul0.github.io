---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="relative py-32 md:py-40 px-6 md:px-12 lg:px-16">

      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-16">
          <!-- Left column - Sticky header -->
          <div class="xl:col-span-4 xl:sticky xl:top-32 xl:self-start">
            <div class="space-y-4 scroll-reveal">
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
                Projects
              </h2>
              <div class="accent-line animate h-3"></div>
            </div>
          </div>

          <!-- Right column - Project cards grid -->
          <div class="xl:col-span-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {siteConfig.projects.map((project, index) => {
                const isLink = !!project.link;

                return (
                  <div class="scroll-reveal" data-delay={String(Math.min(index + 1, 4))}>
                    <a
                      href={isLink ? project.link : undefined}
                      target={isLink ? "_blank" : undefined}
                      rel={isLink ? "noopener noreferrer" : undefined}
                      class={`block h-full group ${isLink ? '' : 'pointer-events-none'}`}
                    >
                      <div class="bezel h-full">
                        <div class="bezel-inner p-6 h-full">
                          <div class="space-y-4">
                            <!-- Project header -->
                            <div class="space-y-2">
                              <div class="flex items-start justify-between gap-4">
                                <h3 class="text-lg md:text-xl font-semibold flex items-center gap-2">
                                  <span class="text-[var(--theme-accent)]">&gt;</span>
                                  {project.name}
                                </h3>
                                {isLink && (
                                  <span class="arrow-badge w-6 h-6 flex-shrink-0 group-hover:translate-x-0.5 group-hover:-translate-y-px">
                                    <svg width="10" height="10" viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                      <path d="M1 7L7 1M7 1H3M7 1V5" />
                                    </svg>
                                  </span>
                                )}
                              </div>
                            </div>

                            <!-- Description -->
                            <p class="text-sm md:text-base text-[var(--theme-text-secondary)] leading-relaxed">
                              {project.description}
                            </p>

                            <!-- Skills -->
                            {project.skills && project.skills.length > 0 && (
                              <div class="flex flex-wrap gap-2 pt-2">
                                {project.skills.map((skill) => (
                                  <span class="skill-pill text-xs">{skill}</span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

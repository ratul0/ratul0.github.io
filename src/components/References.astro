---
import { siteConfig } from "../config";

const hasReferences = siteConfig.references && siteConfig.references.length > 0;

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

const getQuoteParts = (quote: string, highlights: string[]) => {
  const highlightSet = new Set(highlights.map((highlight) => highlight.toLowerCase()));
  const pattern = new RegExp(`(${highlights.map(escapeRegExp).join("|")})`, "gi");

  return quote
    .split(pattern)
    .filter(Boolean)
    .map((text) => ({
      text,
      highlighted: highlightSet.has(text.toLowerCase()),
    }));
};
---

{
  hasReferences && (
    <section id="references" class="relative py-32 md:py-40 px-6 md:px-12 lg:px-16">

      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-16">
          <!-- Left column - Sticky header -->
          <div class="xl:col-span-4 xl:sticky xl:top-32 xl:self-start">
            <div class="space-y-4 scroll-reveal">
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
                References
              </h2>
              <div class="accent-line animate h-3"></div>
            </div>
          </div>

          <!-- Right column - Pull quote cards -->
          <div class="xl:col-span-8">
            <div class="space-y-10 md:space-y-12">
              {siteConfig.references.map((ref, index) => {
                const isCollapsible = ref.quote.length > 420;
                const quoteId = `reference-quote-${index}`;
                const quoteParts = getQuoteParts(ref.quote, ref.highlights);

                return (
                <div class="scroll-reveal" data-delay={String(Math.min(index + 1, 3))}>
                  <div class="bezel">
                    <article class="bezel-inner p-6 md:p-8 relative overflow-visible">
                      <!-- Giant quotation mark -->
                      <span class="quote-mark" aria-hidden="true">&ldquo;</span>

                      <!-- Strength signals -->
                      <ul class="strength-signals relative z-10" aria-label={`Strengths highlighted by ${ref.name}`}>
                        {ref.highlights.map((highlight) => (
                          <li>
                            <span aria-hidden="true">#</span>
                            {highlight}
                          </li>
                        ))}
                      </ul>

                      <!-- Quote -->
                      <div
                        id={quoteId}
                        class:list={["reference-copy relative z-10", { "is-collapsible": isCollapsible }]}
                        data-expanded="false"
                      >
                        <blockquote class="text-base md:text-lg text-[var(--theme-text-secondary)] leading-[1.85] italic pl-1">
                          {quoteParts.map((part) => part.highlighted ? (
                            <mark>{part.text}</mark>
                          ) : part.text)}
                        </blockquote>
                        {isCollapsible && <div class="reference-fade" aria-hidden="true"></div>}
                      </div>

                      {isCollapsible && (
                        <button
                          type="button"
                          class="reference-toggle relative z-10"
                          aria-expanded="false"
                          aria-controls={quoteId}
                          data-reference-toggle
                        >
                          <span class="toggle-more">Read full reference</span>
                          <span class="toggle-less">Show less</span>
                          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 5L7 9L11 5" />
                          </svg>
                        </button>
                      )}

                      <!-- Attribution -->
                      <div class="relative z-10 mt-7 pt-5 border-t border-[var(--theme-border)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div>
                          <p class="text-base font-semibold text-[var(--theme-accent)]">
                            {ref.name}
                          </p>
                          <p class="text-sm text-[var(--theme-text-primary)]">
                            {ref.position}
                          </p>
                        </div>
                        {ref.linkedin && (
                          <a
                            href={ref.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group inline-flex items-center gap-2 text-xs font-medium text-[var(--theme-text-secondary)] transition-colors duration-500 ease-expo hover:text-[var(--theme-accent)]"
                          >
                            <span>LinkedIn</span>
                            <span class="arrow-badge w-5 h-5 group-hover:translate-x-0.5 group-hover:-translate-y-px">
                              <svg width="8" height="8" viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 7L7 1M7 1H3M7 1V5" />
                              </svg>
                            </span>
                          </a>
                        )}
                      </div>
                    </article>
                  </div>
                </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .quote-mark {
    position: absolute;
    top: -8px;
    left: 12px;
    font-size: 6rem;
    line-height: 1;
    font-weight: 700;
    color: var(--theme-accent);
    opacity: 0.12;
    pointer-events: none;
    font-style: normal;
    transition: color 0.5s var(--ease-out-expo);
  }

  .strength-signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .strength-signals li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    max-width: 100%;
    padding: 0.45rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--theme-accent) 42%, var(--theme-border));
    border-radius: 9999px;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    color: var(--theme-text-primary);
    font-size: 0.8125rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .strength-signals li span {
    color: var(--theme-accent);
    font-weight: 700;
  }

  .reference-copy.is-collapsible:not([data-expanded="true"]) blockquote {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    overflow: hidden;
  }

  .reference-copy mark {
    padding: 0.08em 0.12em;
    border-bottom: 1px solid var(--theme-accent);
    background: color-mix(in srgb, var(--theme-accent) 14%, transparent);
    color: var(--theme-text-primary);
    font-weight: 600;
    font-style: inherit;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .reference-fade {
    position: absolute;
    inset: auto 0 0;
    height: 4.5rem;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--theme-bg));
    transition: opacity 0.35s var(--ease-out-expo);
  }

  .reference-copy[data-expanded="true"] .reference-fade {
    opacity: 0;
  }

  .reference-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
    color: var(--theme-accent);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.25s ease;
  }

  .reference-toggle:hover,
  .reference-toggle:focus-visible {
    border-color: currentColor;
  }

  .reference-toggle:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 4px;
  }

  .reference-toggle svg {
    transition: transform 0.35s var(--ease-out-expo);
  }

  .reference-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .toggle-less,
  .reference-toggle[aria-expanded="true"] .toggle-more {
    display: none;
  }

  .reference-toggle[aria-expanded="true"] .toggle-less {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .reference-fade,
    .reference-toggle svg {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-reference-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const quoteId = button.getAttribute("aria-controls");
      const quote = quoteId ? document.getElementById(quoteId) : null;

      if (!quote) return;

      const isExpanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!isExpanded));
      quote.dataset.expanded = String(!isExpanded);
    });
  });
</script>
